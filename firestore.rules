rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth != null;}
  function admin(){return signed() && request.auth.token.email == 'isaacsilvaferreira1234@gmail.com' && request.auth.token.email_verified == true;}
  function barber(){return signed() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'barber';}
  function manages(uid){return admin() || (signed() && request.auth.uid == uid && barber());}
  match /users/{id} {
   allow read: if signed() && (request.auth.uid == id || admin() || resource.data.role == 'barber' || (resource.data.role == 'client' && barber()));
   allow create: if signed() && request.resource.data.keys().hasOnly(['name','email','role','club','clubActive']) && request.resource.data.club == 'none' && request.resource.data.clubActive == false && ((request.resource.data.role == 'client' && (id == request.auth.uid && request.resource.data.email == request.auth.token.email)) || (admin() && request.resource.data.role == 'barber'));
   allow update: if admin() || (signed() && id == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone']));
  }
  match /services/{id} {allow read: if true; allow write: if admin();}
  match /slots/{id} {
   allow read: if signed();
   function valid(){let d=request.resource.data;return d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && d.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]') && d.duration is int && d.duration>0 && d.duration<=1440 && d.active is bool;}
   allow create: if manages(request.resource.data.barberId) && valid() && request.resource.data.booked == false;
   allow update: if manages(resource.data.barberId) && valid() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','date','time','duration']);
  }
  match /appointments/{id} {
   allow read: if signed() && (admin() || resource.data.clientId == request.auth.uid || resource.data.barberId == request.auth.uid);
   allow create: if signed() && request.resource.data.price is number && request.resource.data.price >= 0 && request.resource.data.duration is int && request.resource.data.duration > 0 && request.resource.data.duration<=480 && ((request.resource.data.status=='scheduled' && request.resource.data.clientId==request.auth.uid && get(/databases/$(database)/documents/slots/$(request.resource.data.slotId)).data.active == true && get(/databases/$(database)/documents/slots/$(request.resource.data.slotId)).data.barberId==request.resource.data.barberId) || (request.resource.data.source=='walk-in' && request.resource.data.status=='completed' && request.resource.data.createdBy==request.auth.uid && manages(request.resource.data.barberId)));
   allow update: if signed() && resource.data.status=='scheduled' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && ((request.resource.data.status=='cancelled' && resource.data.clientId==request.auth.uid) || (request.resource.data.status=='completed' && manages(resource.data.barberId)));
  }
  match /bookingLocks/{id} {
   allow read: if signed();
   function valid(){let d=request.resource.data;let a=getAfter(/databases/$(database)/documents/appointments/$(d.appointmentId)).data;return d.barberId==a.barberId && d.date==a.date && d.clientId==a.clientId && d.minute is int && id==d.barberId+'_'+d.date+'_'+string(d.minute) && ((a.status=='scheduled' && a.clientId==request.auth.uid) || (a.status=='completed' && manages(a.barberId)));}
   allow create: if signed() && valid();
   allow delete: if signed() && resource.data.clientId==request.auth.uid && getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.status=='cancelled';
  }
 }
}
