rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
 function signed(){return request.auth!=null;}
 function me(){return get(/databases/$(database)/documents/users/$(request.auth.uid));}
 function role(r){return signed()&&(r=='admin' ? request.auth.token.admin==true : me().data.role==r);}
 function staff(){return role('admin')||role('barber');}
 match /users/{id}{
 allow read: if signed()&&(request.auth.uid==id||role('admin')||resource.data.role=='barber');
 allow create: if signed()&&request.auth.uid==id&&request.resource.data.role=='client'&&request.resource.data.club=='none'&&request.resource.data.clubActive==false;
 allow update: if role('admin')||(signed()&&request.auth.uid==id&&request.resource.data.role==resource.data.role&&request.resource.data.club==resource.data.club&&request.resource.data.clubActive==resource.data.clubActive);
 }
 match /services/{id}{
 allow read: if true;
 allow create,update,delete: if role('admin');
 }
 match /bookingLocks/{id}{
 allow read: if signed();
 allow create: if signed() && request.resource.data.clientId==request.auth.uid && request.resource.data.barberId is string && request.resource.data.date is string && request.resource.data.minute is int && request.resource.data.appointmentId is string && id==request.resource.data.barberId+'_'+request.resource.data.date+'_'+request.resource.data.minute;
 allow delete: if signed() && (resource.data.clientId==request.auth.uid || role('admin'));
 allow update: if false;
 }
 match /slots/{id}{
 allow read: if signed();
 allow create: if staff()&&(role('admin')||request.resource.data.barberId==request.auth.uid)&&request.resource.data.booked==false;
 allow update: if signed()&&(
 (staff()&&(role('admin')||resource.data.barberId==request.auth.uid)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active']))
 ||(request.resource.data.diff(resource.data).affectedKeys().hasOnly(['booked'])&&
 ((resource.data.booked==false&&request.resource.data.booked==true)||
 (resource.data.booked==true&&request.resource.data.booked==false)))
 );
 }
 match /appointments/{id}{
 allow read: if signed()&&(role('admin')||resource.data.clientId==request.auth.uid||resource.data.barberId==request.auth.uid);
 allow create: if signed()&&request.resource.data.clientId==request.auth.uid&&request.resource.data.status=='scheduled'&&request.resource.data.keys().hasAll(['slotId','barberId','date','time','service','price','duration'])&&request.resource.data.price is number&&request.resource.data.price>=0&&request.resource.data.duration is number&&request.resource.data.duration>0;
 allow update: if signed()&&(
 (resource.data.clientId==request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])&&request.resource.data.status=='cancelled')
 ||(staff()&&(role('admin')||resource.data.barberId==request.auth.uid)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])&&request.resource.data.status=='completed'));
 }
 }
}